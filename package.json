{
  "name": "supplyflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:alerts": "node scripts/check-alert-rules.ts",
    "check:dashboard": "node scripts/check-dashboard-series.ts",
    "check:orders": "node scripts/check-order-savings.ts",
    "check:split": "node scripts/check-order-split.ts",
    "check:p2": "node scripts/check-p2-reliability.ts",
    "check:review": "node --test src/components/document-review/model.test.ts",
    "check:tokens": "node scripts/check-design-tokens.ts",
    "build": "tsc --noEmit && npm run check:alerts && npm run check:dashboard && npm run check:orders && npm run check:split && npm run check:p2 && npm run check:review && npm run check:tokens && npm run test && vite build",
    "quality": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-quality-gates.ps1",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "^0.563.0",
    "papaparse": "^5.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "react-pdf": "10.4.1",
    "react-router": "8.3.0",
    "recharts": "^2.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
