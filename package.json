{
  "name": "inplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:supplier-columns": "node scripts/check-supplier-columns.ts",
    "check:assistant-no-send": "node scripts/check-assistant-no-send.mjs",
    "check:assistant-tool-schemas": "node scripts/check-assistant-tool-schemas.mjs",
    "check:anchored-replacements": "node scripts/check-anchored-replacements.mjs",
    "check:exemptions": "node scripts/check-exemption-pin.ts",
    "check:money": "node scripts/check-money.ts",
    "check:tokens": "node scripts/check-design-tokens.ts",
    "check:typography": "node scripts/check-typography.ts",
    "check:dead-code": "knip --config knip.json",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:almoni": "node scripts/build-almoni.mjs",
    "verify": "npm run check:dead-code && npm run check:tokens && npm run check:typography && npm run check:money && npm run check:exemptions && npm run check:supplier-columns && npm run check:assistant-no-send && npm run check:assistant-tool-schemas && npm run check:anchored-replacements && npm run test",
    "check": "npm run build && npm run verify",
    "quality": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-quality-gates.ps1",
    "demo:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-demo-local.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "owner-decisions": "node scripts/owner-decisions-server.mjs --open",
    "test:owner-decisions": "node --test tools/owner-decisions/tests/*.test.mjs && node -e \"console.log('owner-decisions tests passed')\""
  },
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "html2canvas-pro": "^2.3.3",
    "idb": "8.0.3",
    "lucide-react": "^0.563.0",
    "papaparse": "^5.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "10.4.1",
    "react-router": "8.3.0",
    "recharts": "^2.15.0",
    "tus-js-client": "4.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "msw": "^2.15.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
