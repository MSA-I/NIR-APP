{
  "name": "supplyflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:alerts": "node scripts/check-alert-rules.ts",
    "check:dashboard": "node scripts/check-dashboard-series.ts",
    "check:orders": "node scripts/check-order-savings.ts",
    "check:split": "node scripts/check-order-split.ts",
    "check:p2": "node scripts/check-p2-reliability.ts",
    "check:review": "node --test src/components/document-review/model.test.ts",
    "build": "tsc --noEmit && npm run check:alerts && npm run check:dashboard && npm run check:orders && npm run check:split && npm run check:p2 && npm run check:review && vite build",
    "quality": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-quality-gates.ps1",
    "qa:install-browser": "playwright install chromium",
    "qa:typecheck": "tsc -p qa/tsconfig.json --noEmit",
    "qa:test": "node --test qa/**/*.test.ts",
    "qa:setup": "node qa/runner/setup.ts",
    "qa:deterministic": "node qa/runner/deterministic-runner.ts",
    "qa:agents": "node qa/runner/agent-runner.ts",
    "qa:report": "node qa/runner/report-runner.ts",
    "qa:full": "node qa/runner/full-runner.ts",
    "qa:clean": "node qa/runner/clean.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.91.1",
    "lucide-react": "^0.563.0",
    "papaparse": "^5.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "react-router": "8.3.0",
    "recharts": "^2.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
